# GNOME desktop settings. Load with:
#   dconf load /org/gnome/ < gnome/desktop-settings.dconf
# Generated by gnome/dump-desktop.sh; re-run it instead of editing by hand.

[desktop/interface]
clock-format='24h'
color-scheme='prefer-dark'
cursor-theme='MacTahoe-dark'
enable-animations=true
enable-hot-corners=true
icon-theme='MacTahoe-dark'
show-battery-percentage=true

[desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'

[desktop/wm/keybindings]
close=['<Super>q']
move-to-workspace-1=['<Shift><Super>1']
move-to-workspace-2=['<Shift><Super>2']
move-to-workspace-3=['<Shift><Super>3']
move-to-workspace-4=['<Shift><Super>4']
move-to-workspace-down=['<Control><Shift><Alt>Down']
move-to-workspace-left=['<Super><Shift>KP_Prior', '<Super><Shift><Alt>Left', '<Control><Shift><Alt>Left', '<Super><Shift>Page_Up']
move-to-workspace-right=['<Super><Shift>KP_Next', '<Super><Shift><Alt>Right', '<Control><Shift><Alt>Right', '<Super><Shift>Page_Down']
move-to-workspace-up=['<Control><Shift><Alt>Up']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-down=['<Control><Alt>Down']
switch-to-workspace-left=['<Super>a']
switch-to-workspace-right=['<Super>d', '<Super>Page_Down']
switch-to-workspace-up=['<Control><Alt>Up']
toggle-fullscreen=['F11']

[desktop/peripherals/touchpad]
accel-profile='flat'
send-events='enabled'
two-finger-scrolling-enabled=true

[desktop/peripherals/mouse]
accel-profile='flat'

[mutter]
overlay-key='Super'
workspaces-only-on-primary=true

[settings-daemon/plugins/media-keys]
control-center=['<Super>i']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']
home=['<Super>e']
shutdown=['<Control><Super>s']

[settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Super>Return'
command='kitty'
name='Kitty'

[shell/keybindings]
toggle-application-view=@as []

[shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'helium.desktop', 'com.microsoft.VSCode.desktop', 'chrome-fmgjjmmmlfnkbppncabfkddbjimcfncm-Default.desktop', 'claude-desktop-unofficial.desktop', 'chatgpt.desktop', 'org.gnome.TextEditor.desktop', 'chrome-agimnkijcaahngcdmfeangaknmldooml-Default.desktop', 'io.github.shehawey.whatsapp.desktop', 'chrome-aghbiahbpaijignceidepookljebhfak-Default.desktop', 'org.localsend.localsend_app.desktop', 'dev.vencord.Vesktop.desktop', 'chrome-cadlkienfkclaiaibeoongdcgmdikeeg-Default.desktop', 'hermes.desktop']

[desktop/input-sources]
sources=[('xkb', 'us'), ('xkb', 'ara')]

[nautilus/preferences]
default-folder-viewer='icon-view'

