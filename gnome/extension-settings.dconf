[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur': {'name': <'Migrated dynamic blur'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <60>, 'brightness': <0.59999999999999998>}>}>]>}}
rounded-blur-found=false
settings-version=7

[blur-my-shell/appfolder]
pipeline='pipeline_migrated_dynamic_blur'

[blur-my-shell/applications]
blur=false
enable-all=false
opacity=240
pipeline='pipeline_default'
static-blur=true

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
pipeline='pipeline_default'
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
corner-radius=0
pipeline='pipeline_default'

[blur-my-shell/popup]
pipeline='pipeline_default'

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
pipeline='pipeline_migrated_dynamic_blur'

[caffeine]
cli-toggle=true
duration-timer=2
duration-timer-list=[900, 1800, 3600]
indicator-position-max=3
screen-blank='always'
user-enabled=true

[clipboard-indicator]
display-mode=0
next-history-clear=-1
pinned-on-bottom=true

[dash-to-dock]
always-center-icons=true
apply-custom-theme=false
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=48
disable-overview-on-startup=true
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
hot-keys=false
isolate-monitors=false
multi-monitor=true
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'

[desk-widgets]
glass=true
grid-gap=20
layout='{"version":1,"widgets":[{"id":"dafb43","type":"clock","size":"S","col":0,"row":0,"config":{"face":"digital","seconds":true}},{"id":"25176f","type":"calendar","size":"L","col":9,"row":0,"config":{"birthdays":false}},{"id":"f52806","type":"weather","size":"S","col":1,"row":0,"config":{}},{"id":"e4631b","type":"reminders","size":"M","col":9,"row":2,"config":{}},{"id":"1b0f9d","type":"battery","size":"S","col":1,"row":1,"config":{}},{"id":"5c86e5","type":"media","size":"S","col":0,"row":1,"config":{}}]}'
theme-mode='system'
translucency=100

[just-perfection]
activities-button=false
dash=true
panel=true
show-apps-button=false
startup-status=0
workspace-peek=false
workspace-switcher-should-show=true

[live-lockscreen]
# background-video-path stripped (public repo) -- set in the extension's prefs
background-video-scaling-mode=1
prompt-change-blur=true

[ncom/github/hermes83/compiz-alike-magic-lamp-effect]
duration=500.0
effect='default'
x-tiles=15.0
y-tiles=20.0

[prayer-times]
calculation-method='Egyptian'
# latitude stripped (public repo) -- set via Prayer Times prefs
location-auto=false
# longitude stripped (public repo) -- set via Prayer Times prefs
muezzin='egypt'
panel-position='center'
show-prayer-name=true
show-seconds=false

