[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur': {'name': <'Migrated dynamic blur'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <60>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_liquid_glass': {'name': <'Liquid Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_liquid_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'refraction'>, 'id': <'effect_liquid_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_liquid_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_vapor_glass': {'name': <'Vapor Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_vapor_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'wave'>, 'id': <'effect_vapor_glass_wave'>, 'params': <@a{sv} {}>}>, <{'type': <'refraction'>, 'id': <'effect_vapor_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_vapor_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_classic_light_background': {'name': <'Classic Light Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <17>}>}>]>}, 'pipeline_classic_dark_background': {'name': <'Classic Dark Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_dark_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_dark_color'>, 'params': <{'color': <(0.40000000000000002, 0.40000000000000002, 0.40000000000000002, 0.34999999999999998)>, 'blend_mode': <17>}>}>]>}, 'pipeline_default_light': {'name': <'Default (Light mode)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_default_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <1>}>}>, <{'type': <'color'>, 'id': <'effect_default_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.5)>, 'blend_mode': <3>}>}>]>}}
rounded-blur-found=false
settings-version=10

[blur-my-shell/appfolder]
pipeline='pipeline_migrated_dynamic_blur'

[blur-my-shell/applications]
blur=false
enable-all=false
opacity=240
pipeline='pipeline_default'
static-blur=true

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
pipeline='pipeline_default'
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
blur=false
pipeline='pipeline_default'

[blur-my-shell/panel]
corner-radius=0
pipeline='pipeline_default'

[blur-my-shell/popup]
pipeline='pipeline_default'
screenshot-corner-radius=36

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
pipeline='pipeline_migrated_dynamic_blur'

[caffeine]
cli-toggle=false
countdown-timer=0
duration-timer=2
duration-timer-list=[900, 1800, 3600]
indicator-position-max=0
screen-blank='always'
user-enabled=true

[clipboard-indicator]
display-mode=0
next-history-clear=-1
pinned-on-bottom=true
toggle-menu=['<Super>Alt_L']

[dash-to-dock]
always-center-icons=true
apply-custom-theme=false
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=48
disable-overview-on-startup=true
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
hot-keys=false
isolate-monitors=false
multi-monitor=true
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
show-show-apps-button=false

[desk-widgets]
github-token-serial=1
glass=false
grid-gap=14
layout='{"version":1,"widgets":[{"id":"dafb43","type":"clock","size":"S","col":7,"row":0,"config":{"face":"digital","seconds":true}},{"id":"25176f","type":"calendar","size":"S","col":8,"row":0,"config":{"birthdays":false}},{"id":"f52806","type":"weather","size":"S","col":8,"row":1,"config":{}},{"id":"b8ed91","type":"system","size":"S","col":7,"row":1,"config":{}},{"id":"b69394","type":"github","size":"M","col":7,"row":2,"config":{}},{"id":"155406","type":"reminders","size":"M","col":7,"row":3,"config":{}}]}'
theme-mode='dark'
translucency=25
widget-style='nothing'

[dynland]
auto-hide=false
bar-icon-only=['vitalsMenu']
bar-notch-pages=false
bar-quick-indicators=['network', 'bluetooth', 'battery', 'caffeine']
bar-start-indicators=['vitalsMenu', 'clipboardIndicator', 'prayer-times']
bar-status-order=['dwellClick', 'a11y', 'keyboard', 'appindicator-org.kde.StatusNotifierItem-29608-1', 'appindicator-:1.78@/org/ayatana/NotificationItem/YdZnXhxq3_', 'screenRecording', 'screenSharing', 'appindicator-:1.132@/StatusNotifierItem', 'quickSettings']
debug-workspace-log=false
layout='bar'
prayer-lead-minutes=10
reserve-space=true
show-activities=false
show-clock=true
show-quick-settings=true
show-tray-indicators=true
style='blur'

[just-perfection]
activities-button=false
dash=true
panel=true
show-apps-button=false
startup-status=0
workspace-peek=false
workspace-switcher-should-show=true

[live-lockscreen]
# background-video-path stripped (public repo) -- set in the extension's prefs
background-video-scaling-mode=1
prompt-change-blur=true

[mission-control]

[ncom/github/hermes83/compiz-alike-magic-lamp-effect]
duration=500.0
effect='default'
x-tiles=15.0
y-tiles=20.0

[nonlinear-animation]
continuity=true
duration-scale=1.8
reversal=1.0
schema-version=2
selected-curve='user:6d61636f73'
user-curves=['{"v": 1, "id": "user:6d61636f73", "name": "macOS", "kind": "spring", "damping": 0.9, "omega": 12}']

[prayer-times]
calculation-method='Egyptian'
# latitude stripped (public repo) -- set via Prayer Times prefs
location-auto=false
# longitude stripped (public repo) -- set via Prayer Times prefs
muezzin='egypt'
panel-position='center'
show-prayer-name=true
show-seconds=false

[search-light]
animation-speed=100.0
blur-brightness=0.59999999999999998
blur-sigma=30.0
entry-font-size=1
monitor-count=1
preferred-monitor=0
scale-height=0.10000000000000001
scale-width=0.10000000000000001
shortcut-search=['<Super>space']
show-panel-icon=false

[user-theme]
name='MacTahoe-Dark'

[vitals]
battery-colors=@as []
fan-colors=@as []
fixed-widths=true
gpu-colors=@as []
hide-icons=true
hot-sensors=['_memory_usage_', '_system_load_1m_', '__network-rx_max__', '_memory_allocated_']
icon-style=1
memory-colors=@as []
menu-centered=true
position-in-panel=0
processor-colors=@as []
show-battery=true
system-colors=@as []
temperature-colors=@as []
update-time=1
use-higher-precision=true
